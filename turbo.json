{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalDependencies": ["tsconfig.base.json", "vitest.shared.ts", "README.md", "packages/docture/README.md", "packages/cli/README.md", "apps/examples/README.md", "apps/examples/*/README.md"],
  "tasks": {
    "docture#build": {
      "dependsOn": ["^build"],
      "cache": false,
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/LICENSE", "$TURBO_ROOT$/apps/docs/content/**", "$TURBO_ROOT$/apps/docs/examples/**", "$TURBO_ROOT$/apps/docs/lib/**", "$TURBO_ROOT$/apps/docs/scripts/**", "$TURBO_ROOT$/apps/docs/source.config.ts", "$TURBO_ROOT$/apps/docs/package.json", "$TURBO_ROOT$/apps/docs/public/api-symbols.json", "$TURBO_ROOT$/apps/docs/public/schemas/**", "$TURBO_ROOT$/apps/docs/api-reference.ts", "$TURBO_ROOT$/packages/*/package.json", "$TURBO_ROOT$/packages/*/CHANGELOG.md", "$TURBO_ROOT$/scripts/build-package-docs.mjs"],
      "outputs": ["dist/**", "docs/**", "*.tsbuildinfo"]
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "shared/**", "*/index.ts", "tsconfig.json", "package.json", "content/**", "app/**", "lib/**", "components/**"],
      // dist/** for the libraries; .next/** and .source/** for the docs app.
      "outputs": ["dist/**", "*.tsbuildinfo", ".next/**", "!.next/cache/**", ".source/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "test/**", "shared/**", "*/*.ts", "api-reference.ts", "scripts/**", "examples/**", "tsconfig*.json", "package.json", "content/**", "app/**", "lib/**", "components/**"],
      // `tsc -p tsconfig.test.json` is noEmit — the result is the exit code.
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "test/**", "shared/**", "*/*.ts", "vitest.config.ts", "tsconfig*.json", "package.json"],
      "outputs": [],
      "env": ["RUN_LLM", "RUN_OCR"]
    },
    "lint": {
      "inputs": ["src/**", "test/**", "shared/**", "*/*.ts"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    }
  }
}
