{
  "name": "@docture/testing",
  "version": "0.0.2",
  "description": "Conformance suites, doubles, and deterministic extraction and conversion PDF fixtures for Docture.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YasielCabrera/docture.git",
    "directory": "packages/testing"
  },
  "homepage": "https://github.com/YasielCabrera/docture/tree/main/packages/testing#readme",
  "bugs": {
    "url": "https://github.com/YasielCabrera/docture/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@docture/core": "workspace:*",
    "pdfkit": "0.19.1"
  },
  "peerDependencies": {
    "vitest": ">=3"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/pdfkit": "^0.17.6",
    "typescript": "7.0.2",
    "vitest": "4.1.10",
    "zod": "4.4.3"
  }
}
