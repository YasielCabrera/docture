{
  "name": "@docture/testing",
  "version": "0.0.1",
  "description": "Loader conformance suite, in-memory doubles, and deterministic synthetic PDF fixtures for docture.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@docture/core": "workspace:*",
    "pdfkit": "0.19.1"
  },
  "peerDependencies": {
    "vitest": ">=3"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/pdfkit": "^0.17.6",
    "typescript": "7.0.2",
    "vitest": "4.1.10",
    "zod": "4.4.3"
  }
}
