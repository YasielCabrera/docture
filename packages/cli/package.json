{
  "name": "@docture/cli",
  "version": "0.2.0",
  "description": "The Docture command line for extraction, PDF conversion, classification, inspection, and evaluation.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YasielCabrera/docture.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/YasielCabrera/docture/tree/main/packages/cli#readme",
  "bugs": {
    "url": "https://github.com/YasielCabrera/docture/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "docture": "./dist/bin.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/bin.js",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "docture": "workspace:*",
    "ai": "7.0.51",
    "pdfjs-dist": "6.2.108"
  },
  "optionalDependencies": {
    "@napi-rs/canvas": "1.0.10"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "7.0.2",
    "vitest": "4.1.10",
    "zod": "4.4.3",
    "pdfkit": "0.19.1"
  },
  "keywords": [
    "cli",
    "pdf",
    "extraction",
    "structured-data",
    "llm",
    "docture"
  ]
}
