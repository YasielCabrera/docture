{
  "name": "@docture/loader-pdfjs",
  "version": "0.1.0",
  "description": "PdfJsLoader — text-layer and geometry extraction for docture, powered by pdfjs-dist (Mozilla PDF.js).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YasielCabrera/docture.git",
    "directory": "packages/loader-pdfjs"
  },
  "homepage": "https://github.com/YasielCabrera/docture/tree/main/packages/loader-pdfjs#readme",
  "bugs": {
    "url": "https://github.com/YasielCabrera/docture/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@docture/core": "workspace:*",
    "pdfjs-dist": "6.2.108"
  },
  "devDependencies": {
    "@docture/testing": "workspace:*",
    "@types/node": "^24.13.3",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "keywords": [
    "pdf",
    "pdfjs",
    "text-extraction",
    "docture"
  ]
}
