{
  "name": "@docture/raster-canvas",
  "version": "0.0.3",
  "description": "NapiCanvasRasterizer — render PDF pages to PNG/JPEG for docture, using pdfjs-dist and @napi-rs/canvas.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YasielCabrera/docture.git",
    "directory": "packages/raster-canvas"
  },
  "homepage": "https://github.com/YasielCabrera/docture/tree/main/packages/raster-canvas#readme",
  "bugs": {
    "url": "https://github.com/YasielCabrera/docture/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@napi-rs/canvas": "1.0.3",
    "@docture/core": "workspace:*",
    "pdfjs-dist": "6.2.108"
  },
  "devDependencies": {
    "@docture/loader-pdfjs": "workspace:*",
    "@docture/testing": "workspace:*",
    "@types/node": "^24.13.3",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "keywords": [
    "pdf",
    "rasterize",
    "render",
    "canvas",
    "docture"
  ]
}
