            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        },
        "usage": {
          "$ref": "#/$defs/usage"
        },
        "method": {
          "type": "string"
        },
        "fallback": {
          "type": "boolean"
        },
        "diagnostics": {
          "$ref": "#/$defs/jsonValue"
        },
        "startedAt": {
          "type": "string"
        },
        "ms": {
          "type": "number"
