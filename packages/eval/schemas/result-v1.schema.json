{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/YasielCabrera/docture/blob/main/packages/eval/schemas/result-v1.schema.json",
  "title": "Docture eval result, version 1",
  "description": "The common output of @docture/eval. result.json holds every member except cases; cases.jsonl holds one caseResult per line.",
  "type": "object",
  "properties": {
    "format": {
      "const": "docture-eval-result"
    },
    "version": {
      "const": 1
    },
    "run": {
      "$ref": "#/$defs/runInfo"
    },
    "metrics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/metricInfo"
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/summary"
      }
    },
    "cases": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/caseResult"
      }
    },
    "calibration": {
      "$ref": "#/$defs/calibrationReport"
    },
    "grounding": {
      "$ref": "#/$defs/groundingReport"
    },
    "comparison": {
      "$ref": "#/$defs/runComparison"
    },
    "gate": {
      "$ref": "#/$defs/gateResult"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "extensions": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/jsonValue"
      }
    }
  },
  "required": [
    "format",
    "version",
    "run",
    "metrics",
    "summary",
    "cases",
    "warnings",
    "extensions"
  ],
  "additionalProperties": false,
  "$defs": {
    "jsonValue": {
      "description": "Any JSON value."
    },
    "tagValue": {
      "type": [
        "string",
        "number",
        "boolean"
      ]
    },
    "metricValues": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "number",
          "null"
        ]
      }
    },
    "statusCounts": {
      "type": "object",
      "properties": {
        "match": {
          "type": "number"
        },
        "mismatch": {
          "type": "number"
        },
        "omission": {
          "type": "number"
        },
        "hallucination": {
          "type": "number"
        }
      },
      "required": [
        "match",
        "mismatch",
        "omission",
        "hallucination"
      ],
      "additionalProperties": false
    },
    "box": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "width": {
