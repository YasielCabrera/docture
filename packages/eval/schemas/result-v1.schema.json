    "fieldResult": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "actualPath": {
          "type": "string"
        },
        "pattern": {
          "type": "string"
        },
        "segment": {
          "type": "string"
        },
        "status": {
          "enum": [
            "match",
            "mismatch",
            "omission",
            "hallucination"
          ]
        },
        "expected": {
          "$ref": "#/$defs/jsonValue"
        },
        "actual": {
          "$ref": "#/$defs/jsonValue"
        },
        "comparator": {
          "type": "string"
        },
        "similarity": {
          "type": "number"
        },
        "weight": {
          "type": "number"
        },
        "critical": {
          "const": true
        },
        "hint": {
          "$ref": "#/$defs/repairHint"
        },
        "note": {
          "type": "string"
