        "confidence": {
          "type": "number"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidenceRef"
          }
        },
        "locations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/expectedLocation"
          }
        },
        "grounded": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "path",
        "pattern",
        "segment",
        "status",
        "expected",
        "actual",
        "comparator",
        "similarity",
        "weight"
      ],
      "additionalProperties": false
    },
    "alignmentReport": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "pattern": {
          "type": "string"
        },
        "algorithm": {
          "enum": [
            "index",
            "ordered",
            "exact-key",
            "hungarian",
            "greedy",
            "ordered-greedy"
          ]
        },
        "expected": {
          "type": "integer"
        },
        "actual": {
          "type": "integer"
        },
        "matched": {
          "type": "integer"
        },
        "missing": {
          "type": "integer"
        },
        "extra": {
          "type": "integer"
        },
        "outOfOrder": {
          "type": "integer"
        },
        "splits": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "expected": {
                "type": "integer"
              },
              "actual": {
                "type": "array",
                "items": {
                  "type": "integer"
                }
              }
            },
            "required": [
              "expected",
              "actual"
            ],
            "additionalProperties": false
          }
        },
        "merges": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "expected": {
                "type": "array",
                "items": {
                  "type": "integer"
                }
              },
              "actual": {
                "type": "integer"
              }
            },
            "required": [
              "expected",
              "actual"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "path",
        "pattern",
        "algorithm",
        "expected",
        "actual",
        "matched",
        "missing",
        "extra",
        "outOfOrder",
        "splits",
        "merges"
      ],
      "additionalProperties": false
    },
    "assertionResult": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "status": {
          "enum": [
            "pass",
            "fail",
            "skipped"
          ]
        },
        "reason": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "expected": {
          "$ref": "#/$defs/jsonValue"
        },
        "actual": {
          "$ref": "#/$defs/jsonValue"
        }
      },
