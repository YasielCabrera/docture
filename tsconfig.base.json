{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "ES2024.Promise", "ESNext.Disposable"],
    "module": "nodenext",
    "moduleResolution": "nodenext",

    // Node supplies the globals this library uses — AbortSignal, URL, fetch,
    // setTimeout, console. No "dom" lib: nothing here touches a browser API, and
    // pulling DOM in would let a loader accidentally depend on one.
    "types": ["node"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true,

    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    "incremental": true,

    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true
  }
}
