    "evaluate": "tsx evaluate-a-schema/index.ts",
    "synthetic": "tsx synthetic-corpus/index.ts",
    "testing": "tsx testing-your-pipeline/index.ts",
    "ocr-fallback": "tsx input-loaders/ocr.ts",
    "docling-service": "tsx docling/service.ts",
    "model-tool": "tsx checked-tools-eval/tool.ts",
    "service-client": "tsx http-service/client.ts",
    "synthetic-eval": "tsx synthetic-corpus/evaluate.ts",
