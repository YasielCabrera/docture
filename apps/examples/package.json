{
  "name": "@docture/examples",
  "version": "0.0.2",
  "private": true,
  "description": "A browsable tour of every docture feature, on real documents.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "fetch": "tsx shared/fetch.ts",
    "quick-start": "tsx 01-quick-start/index.ts",
    "contracts": "tsx 02-contracts-and-schemas/index.ts",
    "loaders": "tsx 03-loaders-and-sources/index.ts",
    "capabilities": "tsx 04-capabilities-and-composition/index.ts",
    "plugins": "tsx 05-your-own-plugins/index.ts",
    "fallback": "tsx 06-fallback-routing-and-errors/index.ts",
    "model": "tsx 07-with-a-model/index.ts",
    "long": "tsx 08-long-documents/index.ts",
    "scanned": "tsx 09-scanned-and-ocr/index.ts",
    "classify": "tsx 10-classification/index.ts",
    "bundles": "tsx 11-bundles-and-splitting/index.ts",
    "accuracy": "tsx 12-accuracy-and-batch/index.ts",
    "internals": "tsx 13-under-the-hood/index.ts",
    "cli": "tsx 15-cli/index.ts",
    "convert": "tsx 16-document-conversion/index.ts",
    "offline": "pnpm quick-start && pnpm contracts && pnpm loaders && pnpm capabilities && pnpm plugins && pnpm fallback && pnpm long && pnpm classify && pnpm bundles && pnpm accuracy && pnpm internals && pnpm convert && pnpm docling && pnpm checked-tools-eval && pnpm evaluate && pnpm input-loaders && pnpm paperless && pnpm service && pnpm synthetic",
    "all": "pnpm offline && pnpm model && pnpm scanned && pnpm cli",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "clean": "rm -rf documents *.tsbuildinfo",
    "docling": "tsx 18-docling/index.ts",
    "input-loaders": "tsx 20-input-loaders/index.ts && tsx 20-input-loaders/azure.ts && tsx 20-input-loaders/ocr.ts",
    "paperless": "tsx 21-paperless/index.ts",
    "service": "tsx 22-http-service/index.ts",
    "checked-tools-eval": "tsx 19-checked-tools-eval/index.ts",
    "evaluate": "tsx 23-evaluate-a-schema/index.ts",
    "synthetic": "tsx 24-synthetic-corpus/index.ts"
  },
  "dependencies": {
    "docture": "workspace:*",
    "@docture/cli": "workspace:*",
    "@docture/eval": "workspace:*",
    "@docture/synthetic": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "ai": "7.0.51",
    "tsx": "4.20.6",
    "typescript": "7.0.2",
    "vitest": "4.1.10",
    "zod": "4.4.3",
    "@types/pdfkit": "^0.17.6",
    "pdfkit": "0.19.1",
    "pdfjs-dist": "6.2.108",
    "mupdf": "1.28.0",
    "tesseract.js": "7.0.0",
    "ppu-paddle-ocr": "6.3.0",
    "onnxruntime-node": "1.27.0",
    "@napi-rs/canvas": "1.0.10",
    "utif2": "4.1.0",
    "sharp": "0.35.5"
  }
}
