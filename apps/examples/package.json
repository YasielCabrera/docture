{
  "name": "@docture/examples",
  "version": "0.0.2",
  "private": true,
  "description": "Focused document extraction and conversion examples with local input files.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "quick-start": "tsx quick-start/index.ts",
