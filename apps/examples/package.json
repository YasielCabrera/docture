    "ai": "7.0.51",
    "tsx": "4.20.6",
    "typescript": "7.0.2",
    "vitest": "4.1.10",
    "zod": "4.4.3",
    "@types/pdfkit": "^0.17.6",
    "pdfkit": "0.19.1",
    "pdfjs-dist": "6.2.108",
    "mupdf": "1.28.0",
    "tesseract.js": "7.0.0",
    "ppu-paddle-ocr": "6.3.0",
    "onnxruntime-node": "1.27.0",
    "@napi-rs/canvas": "1.0.10",
