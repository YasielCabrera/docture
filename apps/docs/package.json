{
  "name": "@docture/docs",
  "version": "0.0.1",
  "private": true,
  "description": "Documentation site for docture — Fumadocs on Next.js.",
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3100",
    "build": "next build",
    "start": "next start --port 3100",
    "typecheck": "next typegen && tsc --noEmit && pnpm check:docs && pnpm check:fences && pnpm check:examples",
    "check:docs": "pnpm check:brand && node ../../scripts/sync-docture-readme.mjs --check && node ../../scripts/generate-error-table.mjs --check && node ../../scripts/generate-document-schema.mjs --check && node ../../scripts/check-public-jsdoc.mjs && tsx scripts/check-docs.ts && tsx scripts/generate-command-reference.ts --check && tsx scripts/generate-api-index.ts --check",
    "test": "vitest run",
    "clean": "rm -rf .next .source",
    "asset": "tsx scripts/generate-hero-document.ts",
    "brand:sync": "node scripts/sync-brand.mjs",
    "check:brand": "node scripts/sync-brand.mjs --check",
    "check:examples": "tsx scripts/check-examples.ts",
    "check:fences": "tsx scripts/check-fences.ts",
    "check:site": "tsx scripts/smoke-site.ts",
    "check:a11y": "tsx scripts/check-a11y.ts",
    "generate:commands": "tsx scripts/generate-command-reference.ts",
    "generate:api": "tsx scripts/generate-api-index.ts"
  },
  "dependencies": {
    "cnfast": "^0.1.0",
    "fumadocs-core": "16.14.0",
    "fumadocs-mdx": "15.2.2",
    "fumadocs-ui": "16.14.0",
    "lucide-react": "^1.28.0",
    "mermaid": "11.16.1",
    "next": "16.3.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@ai-sdk/openai": "4.0.46",
    "@docture/cli": "workspace:*",
    "@docture/eval": "workspace:*",
    "@docture/synthetic": "workspace:*",
    "@napi-rs/canvas": "1.0.10",
    "@react-pdf/renderer": "4.9.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "ai": "7.0.51",
    "axe-core": "4.14.0",
    "docture": "workspace:*",
    "mupdf": "1.28.0",
    "onnxruntime-node": "1.27.0",
    "pdfjs-dist": "6.2.108",
    "pdfkit": "0.19.1",
    "playwright-core": "1.64.1",
    "postcss": "^8.5.24",
    "ppu-paddle-ocr": "6.3.0",
    "sharp": "0.35.5",
    "simple-icons": "^16.28.0",
    "tailwindcss": "^4.3.3",
    "tesseract.js": "7.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": ">=3",
    "zod": "4.4.3"
  }
}
