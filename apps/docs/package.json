{
  "name": "@docture/docs",
  "version": "0.0.1",
  "private": true,
  "description": "Documentation site for docture — Fumadocs on Next.js.",
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3100",
    "build": "next build",
    "start": "next start --port 3100",
    "typecheck": "next typegen && tsc --noEmit && pnpm check:docs",
    "check:docs": "tsx scripts/check-docs.ts",
    "clean": "rm -rf .next .source",
    "asset": "tsx scripts/generate-hero-document.ts"
  },
  "dependencies": {
    "cnfast": "^0.1.0",
    "fumadocs-core": "16.14.0",
    "fumadocs-mdx": "15.2.2",
    "fumadocs-ui": "16.14.0",
    "lucide-react": "^1.28.0",
    "mermaid": "11.16.1",
    "next": "16.3.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@ai-sdk/openai": "4.0.46",
    "@docture/cli": "workspace:*",
    "@docture/core": "workspace:*",
    "@docture/eval": "workspace:*",
    "@docture/llm": "workspace:*",
    "@docture/loader-mupdf": "workspace:*",
    "@docture/loader-paddleocr": "workspace:*",
    "@docture/loader-pdfjs": "workspace:*",
    "@docture/loader-tesseract": "workspace:*",
    "@docture/raster-canvas": "workspace:*",
    "@docture/testing": "workspace:*",
    "ai": "7.0.51",
    "docture": "workspace:*",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "postcss": "^8.5.24",
    "simple-icons": "^16.28.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "zod": "4.4.3"
  }
}
